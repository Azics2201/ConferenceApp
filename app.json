{
  "expo": {
    "name": "TechConnect Conference",
    "slug": "techconnect-conference",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TechConnect Conference to access your camera to scan attendee badge QR codes."
        }
      ],
      "expo-sharing"
    ]
  }
}
